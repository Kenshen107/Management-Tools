<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>New notice - Management Tools</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="topbar">
    <a class="brand" href="/admin">Management Tools</a>
    <form method="post" action="/admin/logout"><button type="submit" class="secondary">Sign out</button></form>
  </div>
  <div class="wrap">
    <a href="/admin" class="muted">&larr; Back to notices</a>
    <h1>New notice</h1>
    <% if (error) { %><div class="error"><%= error %></div><% } %>
    <div class="card">
      <form method="post" action="/admin/notices/new">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" placeholder="e.g. September policy updates" required>

        <label for="description">Description (optional, shown above the topics)</label>
        <textarea id="description" name="description" placeholder="A short intro employees will see before the topics."></textarea>

        <label for="senderName">Your name (shown in the email as who sent it)</label>
        <input type="text" id="senderName" name="senderName" placeholder="e.g. Jordan, Warehouse Manager">

        <label for="senderEmail">Your email (optional, for your reference)</label>
        <input type="email" id="senderEmail" name="senderEmail" placeholder="you@company.com">

        <button type="submit">Create notice &amp; add topics</button>
      </form>
    </div>
  </div>
</body>
</html>
