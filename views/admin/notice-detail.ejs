<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= notice.title %> - Management Tools</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="topbar">
    <a class="brand" href="/admin">Management Tools</a>
    <form method="post" action="/admin/logout"><button type="submit" class="secondary">Sign out</button></form>
  </div>
  <div class="wrap">
    <a href="/admin" class="muted">&larr; Back to notices</a>
    <h1><%= notice.title %></h1>
    <% if (notice.description) { %><p class="muted"><%= notice.description %></p><% } %>
    <% if (sent) { %><div class="success">Emails sent.</div><% } %>

    <h2>Topics (<%= topics.length %>)</h2>
    <p class="muted">Each topic gets shown to the employee separately, and each one needs its own typed sign-off before it counts as read.</p>

    <% topics.forEach((topic, i) => { %>
      <div class="card">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;">
          <h3><%= i + 1 %>. <%= topic.title %></h3>
          <form method="post" action="/admin/notices/<%= notice.id %>/topics/<%= topic.id %>/delete"
                onsubmit="return confirm('Remove this topic? This also clears any sign-offs already recorded for it.');">
            <button type="submit" class="danger">Remove</button>
          </form>
        </div>
        <p style="white-space:pre-wrap;"><%= topic.body %></p>
        <p class="muted">Required sign-off text: "<%= topic.signOffPrompt %>"</p>
      </div>
    <% }) %>

    <div class="card">
      <h3>Add a topic</h3>
      <form method="post" action="/admin/notices/<%= notice.id %>/topics">
        <label for="title">Topic title</label>
        <input type="text" id="title" name="title" placeholder="e.g. New timesheet procedure" required>

        <label for="body">Topic content</label>
        <textarea id="body" name="body" placeholder="Everything the employee needs to read for this topic." required></textarea>

        <label for="signOffPrompt">Sign-off phrase they must type back (defaults to a standard line if left blank)</label>
        <input type="text" id="signOffPrompt" name="signOffPrompt" placeholder="I have read and understand this.">

        <button type="submit">Add topic</button>
      </form>
    </div>

    <h2>Recipients (<%= assignments.length %>)</h2>
    <div class="card">
      <h3>Add employees</h3>
      <form method="post" action="/admin/notices/<%= notice.id %>/recipients">
        <label for="recipients">One per line: "Name &lt;email@company.com&gt;" or just an email</label>
        <textarea id="recipients" name="recipients" placeholder="Sam Rivera <sam@company.com>&#10;sam@company.com"></textarea>
        <button type="submit">Add recipients</button>
      </form>
    </div>

    <% if (assignments.length > 0 && topics.length > 0) { %>
      <form method="post" action="/admin/notices/<%= notice.id %>/send" style="margin-bottom:18px;">
        <button type="submit">Send notice to all new recipients</button>
        <p class="scroll-hint">Only sends to people who haven't been emailed yet. Use "Resend" below for a specific person.</p>
      </form>
    <% } %>

    <% if (assignments.length > 0) { %>
      <div class="card">
        <table>
          <thead>
            <tr>
              <th>Employee</th>
              <th>Sent</th>
              <th>Opened</th>
              <th>Topics signed off</th>
              <th>Status</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% assignments.forEach(({ assignment, employee, confirmations }) => {
                 const confirmedCount = confirmations.filter(c => c.confirmedAt).length;
                 const total = confirmations.length;
            %>
              <tr>
                <td>
                  <strong><%= employee ? employee.name : 'Unknown' %></strong><br>
                  <span class="muted"><%= employee ? employee.email : '' %></span>
                </td>
                <td><%= assignment.sentAt ? new Date(assignment.sentAt).toLocaleString() : '—' %></td>
                <td><%= assignment.firstOpenedAt ? new Date(assignment.firstOpenedAt).toLocaleString() : '—' %></td>
                <td>
                  <%= confirmedCount %>/<%= total %>
                  <ul class="list-flat">
                    <% confirmations.forEach(c => { %>
                      <li>
                        <% if (c.confirmedAt) { %>
                          <span class="badge good">signed</span>
                        <% } else if (c.viewedAt) { %>
                          <span class="badge warn">opened</span>
                        <% } else { %>
                          <span class="badge neutral">not opened</span>
                        <% } %>
                        <%= c.topicTitle %>
                        <% if (c.confirmedAt) { %>
                          <span class="muted">
                            — <%= c.secondsTaken != null ? c.secondsTaken + 's on screen' : '' %>
                            <% if (c.suspiciouslyFast) { %><span class="badge bad">fast — review</span><% } %>
                          </span>
                        <% } %>
                      </li>
                    <% }) %>
                  </ul>
                </td>
                <td>
                  <% if (assignment.completedAt) { %>
                    <span class="badge good">Complete</span><br>
                    <span class="muted"><%= new Date(assignment.completedAt).toLocaleString() %></span>
                  <% } else if (assignment.firstOpenedAt) { %>
                    <span class="badge warn">In progress</span>
                  <% } else if (assignment.sentAt) { %>
                    <span class="badge neutral">Sent, not opened</span>
                  <% } else { %>
                    <span class="badge neutral">Not sent</span>
                  <% } %>
                </td>
                <td>
                  <form method="post" action="/admin/notices/<%= notice.id %>/send">
                    <input type="hidden" name="assignmentId" value="<%= assignment.id %>">
                    <button type="submit" class="secondary" style="margin-top:0;padding:4px 10px;font-size:0.8rem;">
                      <%= assignment.sentAt ? 'Resend' : 'Send' %>
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</body>
</html>
