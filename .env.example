# Port the app listens on
PORT=3000

# Password required to sign in to the admin/manager dashboard
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session cookie
SESSION_SECRET=change-this-to-something-random

# Public base URL used to build the links employees click in email
# (e.g. https://notices.yourcompany.com or http://localhost:3000)
BASE_URL=http://localhost:3000

# SMTP settings used to send the notice/reminder emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notices@example.com
SMTP_PASS=your-smtp-password
MAIL_FROM="Management Tools <notices@example.com>"

# Optional: email address that gets notified when an employee finishes a notice
NOTIFY_ON_COMPLETE_EMAIL=
